# 使用方法:
#   1. 复制本文件并重命名为 .env
#   2. 在下方对应位置填入你的 API Key
#   3. .env 已被 .gitignore 忽略, 不会上传到 GitHub
# ============================================================================

# API Key
ANTHROPIC_AUTH_TOKEN=

# 端点
ANTHROPIC_BASE_URL=

# 模型名
ANTHROPIC_MODEL=
